# Local development only. Choose a new password before starting the database.
POSTGRES_USER=tenderguard_owner
POSTGRES_PASSWORD=replace-this-local-password
POSTGRES_DB=tenderguard
POSTGRES_PORT=55432
# Set DATABASE_URL in your shell using the same values before running migrations.
# DATABASE_URL=postgresql://tenderguard_owner:YOUR_PASSWORD@127.0.0.1:55432/tenderguard
